    "Cyanide couldn't take the request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Cyanide استلام الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide konnte die Anfrage nicht annehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide no pudo aceptar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide n’a pas pu prendre en charge la demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide non è riuscito ad accettare la richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanideはリクエストを受け付けられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide가 요청을 받을 수 없었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide nie mógł przyjąć żądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cyanide não conseguiu aceitar a solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide не смог принять запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide ไม่สามารถรับคำขอได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide isteği alamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide không thể nhận yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide 无法接收此请求。"
          }
        }
      }
    },
    "Lets CarPlay start while Siri is off, for the current connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt für die aktuelle Verbindung, CarPlay bei deaktiviertem Siri zu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de lancer CarPlay avec Siri désactivé pour la connexion en cours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在当前连接中关闭 Siri 时启动 CarPlay。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite iniciar CarPlay con Siri desactivado en la conexión actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di avviare CarPlay con Siri disattivato per la connessione attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の接続で、SiriがオフでもCarPlayを起動できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 연결에서 Siri가 꺼져 있어도 CarPlay를 시작할 수 있게 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala uruchomić CarPlay przy wyłączonej Siri dla bieżącego połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite iniciar o CarPlay com a Siri desativada na conexão atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет запустить CarPlay с выключенной Siri для текущего подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ CarPlay เริ่มทำงานขณะปิด Siri สำหรับการเชื่อมต่อปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bağlantı için Siri kapalıyken CarPlay’in başlamasını sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép khởi động CarPlay khi Siri tắt đối với kết nối hiện tại."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح بتشغيل CarPlay عند إيقاف Siri للاتصال الحالي."
          }
        }
      }
    },
