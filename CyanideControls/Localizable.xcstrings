    "CarPlay is taking longer than expected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق CarPlay وقتًا أطول من المتوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay braucht länger als erwartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay está tardando más de lo esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay prend plus de temps que prévu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay sta impiegando più tempo del previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlayの処理に予想より時間がかかっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay가 예상보다 오래 걸리고 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay trwa dłużej niż oczekiwano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CarPlay está demorando mais do que o esperado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay отвечает дольше, чем ожидалось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay ใช้เวลานานกว่าที่คาดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay beklenenden uzun sürüyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay đang mất nhiều thời gian hơn dự kiến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 用时比预期更长。"
          }
        }
      }
    },
