            "value": "Вкл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل"
          }
        }
      }
    },
    "Opens Cyanide to let CarPlay start while Siri is off, for the current connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Cyanide, damit CarPlay für die aktuelle Verbindung bei deaktiviertem Siri starten kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Cyanide pour permettre de lancer CarPlay avec Siri désactivé pour la connexion en cours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Cyanide，以便在当前连接中关闭 Siri 时启动 CarPlay。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Cyanide para permitir que CarPlay se inicie con Siri desactivado en la conexión actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Cyanide per consentire l’avvio di CarPlay con Siri disattivato per la connessione attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanideを開き、現在の接続でSiriがオフでもCarPlayを起動できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide를 열어 현재 연결에서 Siri가 꺼져 있어도 CarPlay를 시작할 수 있게 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Cyanide, aby umożliwić uruchomienie CarPlay przy wyłączonej Siri dla bieżącego połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Cyanide para permitir que o CarPlay inicie com a Siri desativada na conexão atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Cyanide, чтобы запустить CarPlay с выключенной Siri для текущего подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Cyanide เพื่อให้ CarPlay เริ่มทำงานขณะปิด Siri สำหรับการเชื่อมต่อปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bağlantı için Siri kapalıyken CarPlay’in başlamasını sağlamak üzere Cyanide’ı açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cyanide để cho phép khởi động CarPlay khi Siri tắt đối với kết nối hiện tại."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Cyanide للسماح بتشغيل CarPlay عند إيقاف Siri للاتصال الحالي."
          }
        }
      }
    },
    "Opens Cyanide to reboot the device. Needs kernel access from an earlier Cyanide run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Cyanide, um das Gerät neu zu starten. Benötigt Kernel-Zugriff aus einem früheren Cyanide-Durchlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Cyanide pour redémarrer l’appareil. Nécessite un accès au noyau obtenu lors d’une exécution précédente de Cyanide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Cyanide 以重新启动设备。需要先前运行 Cyanide 时获得的内核访问权限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Cyanide para reiniciar el dispositivo. Requiere acceso al kernel obtenido en una ejecución anterior de Cyanide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Cyanide per riavviare il dispositivo. Richiede l’accesso al kernel ottenuto in un’esecuzione precedente di Cyanide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanideを開いてデバイスを再起動します。以前のCyanideの実行で取得したカーネルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide를 열어 기기를 재시동합니다. 이전 Cyanide 실행에서 얻은 커널 접근 권한이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Cyanide, aby uruchomić ponownie urządzenie. Wymaga dostępu do jądra z wcześniejszego uruchomienia Cyanide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Cyanide para reiniciar o dispositivo. Requer acesso ao kernel obtido em uma execução anterior do Cyanide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Cyanide для перезагрузки устройства. Требуется доступ к ядру, полученный при предыдущем запуске Cyanide."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Cyanide เพื่อเริ่มการทำงานของอุปกรณ์ใหม่ ต้องใช้สิทธิ์เข้าถึงเคอร์เนลจากการเรียกใช้ Cyanide ก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtı yeniden başlatmak için Cyanide’ı açar. Önceki bir Cyanide çalıştırmasından kalan çekirdek erişimi gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cyanide để khởi động lại thiết bị. Cần quyền truy cập kernel từ một lần chạy Cyanide trước."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Cyanide لإعادة تشغيل الجهاز. يتطلّب وصولًا إلى النواة من تشغيل سابق لـ Cyanide."
          }
        }
      }
    },
    "Opens Cyanide to restart SpringBoard. Live tweaks stop first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Cyanide, um SpringBoard neu zu starten. Laufende Tweaks werden zuerst beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Cyanide pour redémarrer SpringBoard. Les tweaks en cours s’arrêtent d’abord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Cyanide 以重新启动 SpringBoard。运行中的微调会先停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Cyanide para reiniciar SpringBoard. Los tweaks activos se detienen primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Cyanide per riavviare SpringBoard. I tweak attivi vengono prima arrestati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanideを開いてSpringBoardを再起動します。実行中のTweakは先に停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanide를 열어 SpringBoard를 재시동합니다. 실행 중인 트윅이 먼저 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Cyanide, aby uruchomić ponownie SpringBoard. Najpierw zatrzymuje aktywne modyfikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Cyanide para reiniciar o SpringBoard. Os tweaks ativos são interrompidos primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Cyanide для перезапуска SpringBoard. Сначала останавливаются активные твики."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Cyanide เพื่อเริ่มการทำงานของ SpringBoard ใหม่ ทวีคที่ทำงานอยู่จะหยุดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpringBoard’u yeniden başlatmak için Cyanide’ı açar. Etkin ince ayarlar önce durdurulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cyanide để khởi động lại SpringBoard. Các tinh chỉnh đang chạy sẽ dừng trước."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Cyanide لإعادة تشغيل SpringBoard. تتوقف التعديلات النشطة أولًا."
          }
        }
      }
    },
    "Opens Cyanide to turn Location Services on or off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Cyanide, um die Ortungsdienste ein- oder auszuschalten."
          }
